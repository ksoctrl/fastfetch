{
    "logo": {
        "source": "~/.config/fastfetch/logo.txt",
        "type": "file",
        "padding": {
            "top": 3,
            "left": 1,
            "right": 3
        }
    },

    "display": {
        "bar": {
            "width" : 8
        }
    },

    "modules": [
        {
            "type": "custom",
            "format": "\u001b[90m┌─────────────────────────Hardware─────────────────────────┐"
        },
        {
            "type": "host",
            "format": "{name}",
            "key": " PC",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "format": "CPU:  {name} ({cores-physical} cores) @ {freq-max}",
            "key": "│ ├",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "format": "GPU:  {name} ({core-count} cores) @ {frequency}",
            "key": "│ ├󰍛",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "percent": {
                "type": 3,     // Show both percentage number and bar
                "green": 30,   // Values below 30% in green
                "yellow": 80   // 30-80% in yellow, >80% in red
            },
            // Colors the percentage number to match the bar's threshold zone (green/yellow/red)
            "format": "lua:local args=...;local n=tonumber(args.percentage:match(\"[%d%.]+\"));local c=n<30 and 32 or (n<80 and 93 or 91);return string.format(\"RAM:  %s %s / %s (\\27[%dm%s\\27[0m)\",args.percentageBar,args.used,args.total,c,args.percentage)",
            "key": "│ ├󰍛",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "percent": {
                "type": 3,     // Show both percentage number and bar
                "green": 30,   // Values below 30% in green
                "yellow": 80   // 30-80% in yellow, >80% in red
            },
            // Colors the percentage number to match the bar's threshold zone (green/yellow/red)
            "format": "lua:local args=...;local n=tonumber(args.sizePercentage:match(\"[%d%.]+\"));local c=n<30 and 32 or (n<80 and 93 or 91);return string.format(\"SSD:  %s %s / %s (\\27[%dm%s\\27[0m)\",args.sizePercentageBar,args.sizeUsed,args.sizeTotal,c,args.sizePercentage)",
            "key": "│ ├󰍛",
            "keyColor": "green"
        },
        {
            "type": "battery",
            "temp": true,
            "percent": {
                "type": 3,     // Show both percentage number and bar
                "yellow": 25,  // Values below 25% in red
                "green": 50    // 25-50% in yellow, >50% in green
            },
            // Colors the percentage number to match the bar's threshold zone (inverted: low = red, high = green); falls back to "Charging" when there's no discharge estimate
            "format": "lua:local args=...;local n=tonumber(args.capacity:match(\"[%d%.]+\"));local c=n<25 and 91 or (n<50 and 93 or 32);local remaining=args.timeFormatted~=\"\" and (args.timeFormatted..\" left\") or \"Charging\";return string.format(\"Power:%s \\27[%dm%s\\27[0m (%s) - %s\",args.capacityBar,c,args.capacity,remaining,args.temperature)",
            "key": "└ └󰍛",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "\u001b[90m┌─────────────────────────Software─────────────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "format": "Kernel:    {sysname} {release}",
            "key": "│ ├",
            "keyColor": "yellow"
        },
        {
            "type": "localip",
            "format": "Local IP:  {ipv4}",
            "key": "│ ├",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "format": "Packages:  {brew} (brew), {brew-cask} (brew-cask)",
            "key": "│ ├󰏖",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "format": "Shell:     {exe-name} {version}",
            "key": "└ └",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "format": "{pretty-name}{?version} {version}{?}{?plugin-name} (with {plugin-name}){?}",
            "key": " Desktop",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "format": "Theme:     {result}",
            "key": "│ ├󰉼",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "format": "Terminal:  {pretty-name} {version}",
            "key": "│ ├",
            "keyColor": "blue"
        },
        {
            "type": "terminalfont",
            "format": "Font:      {name} ({size}pt)",
            "key": "└ └",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "\u001b[90m┌───────────────────────System Status──────────────────────┐"
        },
        {
            "type": "uptime",
            "key": "  Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "datetime",
            "key": "  DateTime",
            "keyColor": "magenta"
        },
        {
            "type": "weather",
            "location": "[ZIP/Airport Code]", // Add Zip or Airport code
            "timeout": 2000,
            "outputFormat": "%c%t+-+%C+(%l)&u", //"%c%t+-+%C+(%l)",
            "format": "lua:local args=...;return (args.result:gsub('%s%s+', ' '))",
            "key": "  Weather",
            "keyColor": "magenta"
        },

        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "                 \u001b[38;5;3m󰮯 ⚬ ⚬ ⚬ ⚬ ⚬ \u001b[38;5;8m󰊠 \u001b[38;5;7m󰊠 \u001b[38;5;6m󰊠 \u001b[38;5;5m󰊠 \u001b[38;5;4m󰊠 \u001b[38;5;2m󰊠 \u001b[38;5;1m󰊠"
        }
    ]
}
